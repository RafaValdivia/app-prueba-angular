{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/**/*.ts",
    "src/**/*.html",
    "src/**/*.css",
    "src/**/*.scss",
    "src/**/*.less",
    "src/**/*.styl",
    "src/**/*.json",
    "src/**/*.svg",
    "src/**/*.png",
    "src/**/*.jpg",
    "src/**/*.jpeg",
    "src/**/*.gif",
    "src/**/*.bmp",
    "src/**/*.webp",
    "src/**/*.ico",
    "src/**/*.eot",
    "src/**/*.ttf",
  ]
}
